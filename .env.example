# ── Flask Backend ───────────────────────────────────────────
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
SECRET_KEY=your_secret_key_here

# ── Model ───────────────────────────────────────────────────
BASE_MODEL_NAME=ai4bharat/indic-bert
FINETUNED_MODEL_PATH=training/checkpoints/best_model
HF_TOKEN=your_huggingface_token_here

# ── RAG ─────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/LaBSE
CHROMA_DB_PATH=data/vector_store
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# ── Weights & Biases (for training tracking) ────────────────
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=kannada-legal-ai

# ── Legal Disclaimer ────────────────────────────────────────
